# Quadra API — variables de entorno. SOLO NOMBRES: nunca pongas valores aquí.
# Copia a apps/api/.env (ignorado por git) y rellena desde el canal privado del equipo.
# Con este archivo tal cual, `npm run start` levanta GET /api/health; las rutas de negocio
# responden 401 (sin JWKS) o 503 (sin base de datos).

# Proyecto Supabase. El emisor esperado del JWT se deriva de aquí (<SUPABASE_URL>/auth/v1).
SUPABASE_URL=
# Publishable key: pública, la usa el front para el login.
SUPABASE_PUBLISHABLE_KEY=
# Secret key: SOLO en el servidor (nunca en el front ni con prefijo VITE_). El API aún no la usa.
SUPABASE_SECRET_KEY=
# JWKS del proyecto (signing keys): https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_JWKS_URL=

# Postgres (session pooler o conexión directa, puerto 5432). El API abre cada request en una
# transacción con los claims del usuario y SET LOCAL ROLE authenticated (RLS activo).
DATABASE_URL=

# Claude (narración del bridge, QB-19). Solo servidor.
ANTHROPIC_API_KEY=
